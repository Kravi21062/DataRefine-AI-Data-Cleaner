import pandas as pd

from app.core.session_store import create_session, set_dataset
from app.services.cleaning import apply_cleaning_operation
from app.services.profiling import compute_quality_score, profile_dataset


def test_quality_score_and_profile_smoke():
    df = pd.DataFrame({
        "name": ["Alice", "Bob", "Alice", "Charlie"],
        "age": [25, 30, None, 40],
        "sales": [100, 110, 140, 160],
    })
    summary = profile_dataset(df)
    assert summary["rows"] == 4
    assert summary["missing"] == 1
    assert summary["quality_score"] >= 0
    assert compute_quality_score(df) >= 0


def test_missing_fill_and_duplicate_drop():
    df = pd.DataFrame({
        "a": [1, 2, None, 2],
        "b": ["x", "x", "y", "x"],
    })
    filled = apply_cleaning_operation(df, "fill_missing", strategy="mean")
    deduped = apply_cleaning_operation(filled, "drop_duplicates")
    assert filled["a"].isna().sum() == 0
    assert deduped["a"].tolist() == [1.0, 2.0, 2.0]


def test_session_upload_flow():
    sid = create_session()
    df = pd.DataFrame({"col1": [1, 2, 3], "col2": ["a", "b", "c"]})
    set_dataset(sid, df, "demo.csv", {"name": "demo.csv"})
    assert sid in __import__("app.core.session_store", fromlist=["SESSIONS"]).SESSIONS
    assert len(__import__("app.core.session_store", fromlist=["SESSIONS"]).SESSIONS[sid]["clean_df"]) == 3
